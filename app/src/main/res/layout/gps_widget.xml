<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="4dp"
    android:background="@drawable/widget_background">

    <ImageButton
        android:id="@+id/widget_gps_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_background"
        android:src="@drawable/widget_ic_gps"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Toggle GPS tracking" />

    <ImageButton
        android:id="@+id/widget_realtime_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_background"
        android:src="@drawable/widget_ic_realtime"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Toggle real-time tracking" />

    <ImageButton
        android:id="@+id/widget_open_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_background"
        android:src="@drawable/widget_ic_open"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Open GPS Tracker" />

</LinearLayout>
